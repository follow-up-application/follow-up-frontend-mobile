# Plantilla de configuración local. Copiala a .env y ajustá la URL.
# .env está en .gitignore, así que este archivo es la única referencia versionada.

# URL base de la API. El prefijo EXPO_PUBLIC_ la expone al bundle del cliente.
# config/api.ts la normaliza y cae a la URL de ejemplo si no está definida.
#
# Emulador Android:  http://10.0.2.2:8000/api/v1
# Dispositivo físico: http://<IP-DE-LA-PC>:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1